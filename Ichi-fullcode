// ═══════════════════════════════════════════════════════════════════════════════
// CALCULATE ICHIMOKU COMPONENTS
// ═══════════════════════════════════════════════════════════════════════════════
tenkan = calc_line(i_tenkan, i_engine)
kijun = calc_line(i_kijun, i_engine)
senkou_a = (tenkan + kijun) / 2
senkou_b = calc_line(i_senkou, i_engine)
chikou = close
float tenkan2 = na, float kijun2 = na, float senkou_a2 = na, float senkou_b2 = na
float tenkan3 = na, float kijun3 = na, float senkou_a3 = na, float senkou_b3 = na
if i_mode == "Multi-Cloud (2 Layers)" or i_mode == "Multi-Cloud (3 Layers)"
    t2_len = int(i_tenkan * i_second_cloud_mult)
    k2_len = int(i_kijun * i_second_cloud_mult)
    s2_len = int(i_senkou * i_second_cloud_mult)
    tenkan2 := calc_line(t2_len, i_engine)
    kijun2 := calc_line(k2_len, i_engine)
    senkou_a2 := (tenkan2 + kijun2) / 2
    senkou_b2 := calc_line(s2_len, i_engine)
if i_mode == "Multi-Cloud (3 Layers)"
    t3_len = int(i_tenkan * i_third_cloud_mult)
    k3_len = int(i_kijun * i_third_cloud_mult)
    s3_len = int(i_senkou * i_third_cloud_mult)
    tenkan3 := calc_line(t3_len, i_engine)
    kijun3 := calc_line(k3_len, i_engine)
    senkou_a3 := (tenkan3 + kijun3) / 2
    senkou_b3 := calc_line(s3_len, i_engine)
atr_value = ta.atr(i_atr_period)
// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL LOGIC
// ═══════════════════════════════════════════════════════════════════════════════
cloud_top = math.max(senkou_a[i_displacement], senkou_b[i_displacement])
cloud_bottom = math.min(senkou_a[i_displacement], senkou_b[i_displacement])
price_above_cloud = close > cloud_top
price_below_cloud = close < cloud_bottom
price_in_cloud = not price_above_cloud and not price_below_cloud
future_bull = senkou_a > senkou_b
cloud_twist = ta.crossover(senkou_a, senkou_b) or ta.crossunder(senkou_a, senkou_b)
tk_cross_bull = ta.crossover(tenkan, kijun)
tk_cross_bear = ta.crossunder(tenkan, kijun)
price_cross_bull = ta.crossover(close, kijun)
price_cross_bear = ta.crossunder(close, kijun)
kumo_break_bull = ta.crossover(close, cloud_top)
kumo_break_bear = ta.crossunder(close, cloud_bottom)
chikou_clear_bull = close > high[i_displacement]
chikou_clear_bear = close < low[i_displacement]
perfect_bull = price_above_cloud and cloud_top > tenkan and tenkan > kijun
perfect_bear = price_below_cloud and cloud_bottom < tenkan and tenkan < kijun
bool buy_signal = false
bool sell_signal = false
if i_signal_mode == "TK Cross"
    buy_signal := tk_cross_bull
    sell_signal := tk_cross_bear
else if i_signal_mode == "Price x Kijun"
    buy_signal := price_cross_bull
    sell_signal := price_cross_bear
else if i_signal_mode == "Kumo Breakout"
    buy_signal := kumo_break_bull
    sell_signal := kumo_break_bear
else if i_signal_mode == "TK + Kumo"
    buy_signal := tk_cross_bull and price_above_cloud
    sell_signal := tk_cross_bear and price_below_cloud
else if i_signal_mode == "Perfect Order"
    buy_signal := perfect_bull and tk_cross_bull
    sell_signal := perfect_bear and tk_cross_bear
else if i_signal_mode == "Chikou Confirm"
    buy_signal := tk_cross_bull and chikou_clear_bull
    sell_signal := tk_cross_bear and chikou_clear_bear
else if i_signal_mode == "Triple Confirm"
    buy_signal := tk_cross_bull and price_above_cloud and chikou_clear_bull
    sell_signal := tk_cross_bear and price_below_cloud and chikou_clear_bear
else if i_signal_mode == "Cloud Twist"
    buy_signal := cloud_twist and future_bull
    sell_signal := cloud_twist and not future_bull
// ═══════════════════════════════════════════════════════════════════════════════
// SIGNAL FILTERS
// ═══════════════════════════════════════════════════════════════════════════════
bool filter_pass = true
if i_enable_filters
    if i_filter_volume
        vol_avg = ta.sma(volume, 20)
        if volume < vol_avg * i_vol_threshold
            filter_pass := false
    if i_filter_atr
        atr = ta.atr(14)
        atr_avg = ta.sma(atr, 50)
        if atr < atr_avg * i_atr_min
            filter_pass := false
    if i_filter_adx
        [_, _, adx] = ta.dmi(14, 14)
        if adx < i_adx_threshold
            filter_pass := false
    var int bars_since_sig = 999
    if buy_signal or sell_signal
        if bars_since_sig < i_filter_time
            filter_pass := false
        else
            bars_since_sig := 0
    bars_since_sig += 1
buy_signal := buy_signal and filter_pass
sell_signal := sell_signal and filter_pass
// ═══════════════════════════════════════════════════════════════════════════════
// PERFORMANCE TRACKING
// ═══════════════════════════════════════════════════════════════════════════════
var TradeStats stats = TradeStats.new()
stats.current_equity := i_capital
var float current_sl = na
var float current_tp1 = na
var float current_tp2 = na
var float current_tp3 = na
if i_perf_enable
    if stats.in_trade
        if stats.direction == 1 
            if not stats.tp1_hit and high >= stats.tp1_price
                stats.tp1_hit := true
                stats.tp1_count += 1
            if not stats.tp2_hit and high >= stats.tp2_price
                stats.tp2_hit := true
                stats.tp2_count += 1
            if not stats.tp3_hit and high >= stats.tp3_price
                stats.tp3_hit := true
                stats.tp3_count += 1
        else  
            if not stats.tp1_hit and low <= stats.tp1_price
                stats.tp1_hit := true
                stats.tp1_count += 1
            if not stats.tp2_hit and low <= stats.tp2_price
                stats.tp2_hit := true
                stats.tp2_count += 1
            if not stats.tp3_hit and low <= stats.tp3_price
                stats.tp3_hit := true
                stats.tp3_count += 1
        bool sl_hit = false
        bool exit_signal = false
        if stats.direction == 1
            sl_hit := low <= stats.sl_price
            exit_signal := sell_signal or tk_cross_bear or stats.tp3_hit
        else
            sl_hit := high >= stats.sl_price
            exit_signal := buy_signal or tk_cross_bull or stats.tp3_hit
        if sl_hit or exit_signal
            float exit_price = 0.0
            if sl_hit
                exit_price := stats.sl_price
            else if stats.tp3_hit
                exit_price := stats.tp3_price
            else
                exit_price := close
            pnl_pct = stats.direction == 1 ? 
                 (exit_price - stats.entry_price) / stats.entry_price : 
                 (stats.entry_price - exit_price) / stats.entry_price
            position_value = stats.current_equity * (i_position_size / 100)
            gross_pnl = position_value * pnl_pct
            comm = position_value * (i_commission / 100) * 2
            net_pnl = gross_pnl - comm
            stats.total_pnl += net_pnl
            stats.current_equity += net_pnl
            stats.trades += 1
            if net_pnl > 0
                stats.wins += 1
                stats.win_pnl += net_pnl
            else
                stats.losses += 1
                stats.loss_pnl += math.abs(net_pnl)
            stats.peak_equity := math.max(stats.peak_equity, stats.current_equity)
            dd = (stats.peak_equity - stats.current_equity) / stats.peak_equity * 100
            stats.max_dd := math.max(stats.max_dd, dd)
            stats.in_trade := false
            current_sl := na
            current_tp1 := na
            current_tp2 := na
            current_tp3 := na
    if not stats.in_trade
        if buy_signal
            stats.in_trade := true
            stats.direction := 1
            stats.entry_price := close
            stats.entry_atr := atr_value
            stats.sl_price := close - (atr_value * i_sl_atr_mult)
            stats.tp1_price := close + (atr_value * i_tp1_atr_mult)
            stats.tp2_price := close + (atr_value * i_tp2_atr_mult)
            stats.tp3_price := close + (atr_value * i_tp3_atr_mult)
            stats.tp1_hit := false
            stats.tp2_hit := false
            stats.tp3_hit := false
            current_sl := stats.sl_price
            current_tp1 := stats.tp1_price
            current_tp2 := stats.tp2_price
            current_tp3 := stats.tp3_price
        if sell_signal
            stats.in_trade := true
            stats.direction := -1
            stats.entry_price := close
            stats.entry_atr := atr_value
            stats.sl_price := close + (atr_value * i_sl_atr_mult)
            stats.tp1_price := close - (atr_value * i_tp1_atr_mult)
            stats.tp2_price := close - (atr_value * i_tp2_atr_mult)
            stats.tp3_price := close - (atr_value * i_tp3_atr_mult)
            stats.tp1_hit := false
            stats.tp2_hit := false
            stats.tp3_hit := false
            current_sl := stats.sl_price
            current_tp1 := stats.tp1_price
            current_tp2 := stats.tp2_price
            current_tp3 := stats.tp3_price
// ═══════════════════════════════════════════════════════════════════════════════
// VISUALIZATION 
// ═══════════════════════════════════════════════════════════════════════════════
bool is_bull_cloud = senkou_a >= senkou_b
show_tenkan_line = i_tenkan_show and i_mode != "Kumo Only" and i_mode != "Minimal"
show_kijun_line = i_kijun_show and i_mode != "Kumo Only" and i_mode != "Minimal"
show_chikou_line = i_chikou_show and i_mode == "Full Ichimoku"
show_cloud = i_cloud_style != "None"
// ─────────────────────────────────────────────────────────────────────────────
// TENKAN & KIJUN LINES 
// ─────────────────────────────────────────────────────────────────────────────
plot(show_tenkan_line ? tenkan : na, "Tenkan-sen", i_tenkan_color, i_line_width)
plot(show_tenkan_line and i_glow_effect ? tenkan : na, "Tenkan Glow", color.new(i_tenkan_color, 70), i_line_width + 3)
plot(show_kijun_line ? kijun : na, "Kijun-sen", i_kijun_color, i_line_width)
plot(show_kijun_line and i_glow_effect ? kijun : na, "Kijun Glow", color.new(i_kijun_color, 70), i_line_width + 3)
plot(show_chikou_line ? chikou : na, "Chikou Span", i_chikou_color, 1, offset=-i_displacement)
// ─────────────────────────────────────────────────────────────────────────────
// CLOUD PLOTTING
// ─────────────────────────────────────────────────────────────────────────────
float plot_span_a = show_cloud ? senkou_a : na
float plot_span_b = show_cloud ? senkou_b : na
float cloud_25 = senkou_b + (senkou_a - senkou_b) * 0.25
float cloud_50 = senkou_b + (senkou_a - senkou_b) * 0.5
float cloud_75 = senkou_b + (senkou_a - senkou_b) * 0.75
color cloud_bull_main = color.new(i_bull_cloud, i_cloud_brightness)
color cloud_bear_main = color.new(i_bear_cloud, i_cloud_brightness)
color cloud_bull_edge = color.new(i_bull_cloud, i_cloud_brightness - 15)
color cloud_bear_edge = color.new(i_bear_cloud, i_cloud_brightness - 15)
color cloud_bull_inner = color.new(i_bull_cloud, i_cloud_brightness + 8)
color cloud_bear_inner = color.new(i_bear_cloud, i_cloud_brightness + 8)
bool is_solid = i_cloud_style == "Solid Fill"
p_solid_a = plot(show_cloud and is_solid ? senkou_a : na, "Cloud A", color=na, offset=i_displacement, display=display.none)
p_solid_b = plot(show_cloud and is_solid ? senkou_b : na, "Cloud B", color=na, offset=i_displacement, display=display.none)
fill(p_solid_a, p_solid_b, is_bull_cloud ? cloud_bull_main : cloud_bear_main, "Solid Cloud")
bool is_gradient = i_cloud_style == "Gradient Fill"
p_grad_a = plot(show_cloud and is_gradient ? senkou_a : na, "Grad A", color=na, offset=i_displacement, display=display.none)
p_grad_75 = plot(show_cloud and is_gradient ? cloud_75 : na, "Grad 75", color=na, offset=i_displacement, display=display.none)
p_grad_50 = plot(show_cloud and is_gradient ? cloud_50 : na, "Grad 50", color=na, offset=i_displacement, display=display.none)
p_grad_25 = plot(show_cloud and is_gradient ? cloud_25 : na, "Grad 25", color=na, offset=i_displacement, display=display.none)
p_grad_b = plot(show_cloud and is_gradient ? senkou_b : na, "Grad B", color=na, offset=i_displacement, display=display.none)
fill(p_grad_a, p_grad_75, is_gradient ? (is_bull_cloud ? cloud_bull_edge : cloud_bear_edge) : na, "Grad Layer 1")
fill(p_grad_75, p_grad_50, is_gradient ? (is_bull_cloud ? cloud_bull_inner : cloud_bear_inner) : na, "Grad Layer 2")
fill(p_grad_50, p_grad_25, is_gradient ? (is_bull_cloud ? cloud_bull_inner : cloud_bear_inner) : na, "Grad Layer 3")
fill(p_grad_25, p_grad_b, is_gradient ? (is_bull_cloud ? cloud_bull_edge : cloud_bear_edge) : na, "Grad Layer 4")
bool is_outline = i_cloud_style == "Outline Only"
plot(show_cloud and is_outline ? senkou_a : na, "Outline A", is_bull_cloud ? color.new(i_bull_cloud, 30) : color.new(i_bear_cloud, 30), 2, offset=i_displacement)
plot(show_cloud and is_outline ? senkou_b : na, "Outline B", is_bull_cloud ? color.new(i_bull_cloud, 30) : color.new(i_bear_cloud, 30), 2, offset=i_displacement)
plot(show_cloud and is_outline ? cloud_50 : na, "Outline Mid", is_bull_cloud ? color.new(i_bull_cloud, 70) : color.new(i_bear_cloud, 70), 1, plot.style_circles, offset=i_displacement)
// ─────────────────────────────────────────────────────────────────────────────
// MULTI-CLOUD
// ─────────────────────────────────────────────────────────────────────────────
show_cloud2 = (i_mode == "Multi-Cloud (2 Layers)" or i_mode == "Multi-Cloud (3 Layers)") and show_cloud and not is_outline
show_cloud3 = i_mode == "Multi-Cloud (3 Layers)" and show_cloud and not is_outline
bool is_bull_cloud2 = not na(senkou_a2) and senkou_a2 >= senkou_b2
bool is_bull_cloud3 = not na(senkou_a3) and senkou_a3 >= senkou_b3
p_mc2_a = plot(show_cloud2 ? senkou_a2 : na, "MC2 A", color=na, offset=i_displacement, display=display.none)
p_mc2_b = plot(show_cloud2 ? senkou_b2 : na, "MC2 B", color=na, offset=i_displacement, display=display.none)
fill(p_mc2_a, p_mc2_b, show_cloud2 ? (is_bull_cloud2 ? color.new(i_bull_cloud, 90) : color.new(i_bear_cloud, 90)) : na, "Multi Cloud 2")
p_mc3_a = plot(show_cloud3 ? senkou_a3 : na, "MC3 A", color=na, offset=i_displacement, display=display.none)
p_mc3_b = plot(show_cloud3 ? senkou_b3 : na, "MC3 B", color=na, offset=i_displacement, display=display.none)
fill(p_mc3_a, p_mc3_b, show_cloud3 ? (is_bull_cloud3 ? color.new(i_bull_cloud, 93) : color.new(i_bear_cloud, 93)) : na, "Multi Cloud 3")
// ─────────────────────────────────────────────────────────────────────────────
// SL/TP LINES 
// ─────────────────────────────────────────────────────────────────────────────
plot(i_perf_enable and i_show_sl_tp and stats.in_trade ? current_sl : na, "Stop Loss", color.new(color.red, 30), 2, plot.style_linebr)
plot(i_perf_enable and i_show_sl_tp and stats.in_trade ? current_tp1 : na, "TP1", color.new(color.green, 50), 1, plot.style_linebr)
plot(i_perf_enable and i_show_sl_tp and stats.in_trade ? current_tp2 : na, "TP2", color.new(color.green, 30), 1, plot.style_linebr)
plot(i_perf_enable and i_show_sl_tp and stats.in_trade ? current_tp3 : na, "TP3", color.new(color.lime, 20), 2, plot.style_linebr)
// ─────────────────────────────────────────────────────────────────────────────
// SIGNAL SHAPES 
// ─────────────────────────────────────────────────────────────────────────────
plotshape(i_show_signals and buy_signal, "Buy Signal", shape.labelup, location.belowbar,color.new(#26A69A, 0), text="▲ LONG", textcolor=color.white, size=size.tiny)
plotshape(i_show_signals and sell_signal, "Sell Signal", shape.labeldown, location.abovebar,color.new(#EF5350, 0), text="▼ SHORT", textcolor=color.white, size=size.tiny)
plotshape(show_cloud and cloud_twist, "Cloud Twist", shape.diamond, location.absolute,color.new(color.yellow, 0), size=size.tiny)

// ─────────────────────────────────────────────────────────────────────────────
// BACKGROUND ZONES
// ─────────────────────────────────────────────────────────────────────────────
color bg_zone = na
if i_show_zones
    if price_above_cloud
        bg_zone := color.new(#26A69A, 95)
    else if price_below_cloud
        bg_zone := color.new(#EF5350, 95)
    else if price_in_cloud
        bg_zone := color.new(color.gray, 97)
bgcolor(bg_zone, title="Price Zone")
// ═══════════════════════════════════════════════════════════════════════════════
// DASHBOARD
// ═══════════════════════════════════════════════════════════════════════════════
tenkan_slope = tenkan - tenkan[1]
kijun_slope = kijun - kijun[1]
cloud_thickness = math.abs(senkou_a - senkou_b)
cloud_thickness_pct = close != 0 ? (cloud_thickness / close) * 100 : 0
dist_from_cloud = price_above_cloud ? close - cloud_top : price_below_cloud ? close - cloud_bottom : 0
dist_from_cloud_pct = close != 0 ? (dist_from_cloud / close) * 100 : 0
tk_spread = tenkan - kijun
tk_spread_pct = kijun != 0 ? (tk_spread / kijun) * 100 : 0
momentum_score = 50.0
if price_above_cloud
    momentum_score += 15
if price_below_cloud
    momentum_score -= 15
if tenkan > kijun
    momentum_score += 15
if tenkan < kijun
    momentum_score -= 15
if future_bull
    momentum_score += 10
if not future_bull
    momentum_score -= 10
if chikou_clear_bull
    momentum_score += 10
if chikou_clear_bear
    momentum_score -= 10
momentum_score := math.max(0, math.min(100, momentum_score))
signal_strength = 0
if price_above_cloud
    signal_strength += 1
if tenkan > kijun
    signal_strength += 1
if future_bull
    signal_strength += 1
if chikou_clear_bull
    signal_strength += 1
if price_below_cloud
    signal_strength -= 1
if tenkan < kijun
    signal_strength -= 1
if not future_bull
    signal_strength -= 1
if chikou_clear_bear
    signal_strength -= 1
var int bars_since_signal = 0
if buy_signal or sell_signal
    bars_since_signal := 0
else
    bars_since_signal += 1
vol_avg = ta.sma(volume, 20)
vol_ratio = vol_avg > 0 ? volume / vol_avg : 1.0
atr_avg = ta.sma(atr_value, 50)
atr_ratio = atr_avg > 0 ? atr_value / atr_avg : 1.0
[diplus, diminus, adx_val] = ta.dmi(14, 14)
vol_filter_pass = not i_filter_volume or volume >= vol_avg * i_vol_threshold
atr_filter_pass = not i_filter_atr or atr_value >= atr_avg * i_atr_min
adx_filter_pass = not i_filter_adx or adx_val >= i_adx_threshold
time_filter_pass = bars_since_signal >= i_filter_time
tp1_pct = stats.trades > 0 ? (stats.tp1_count / stats.trades) * 100 : 0.0
tp2_pct = stats.trades > 0 ? (stats.tp2_count / stats.trades) * 100 : 0.0
tp3_pct = stats.trades > 0 ? (stats.tp3_count / stats.trades) * 100 : 0.0
if i_dash_enable
    dash_pos = switch i_dash_position
        "Top Right" => position.top_right
        "Top Left" => position.top_left
        "Bottom Right" => position.bottom_right
        "Bottom Left" => position.bottom_left
        => position.top_right
    text_sz = switch i_dash_size
        "Tiny" => size.tiny
        "Small" => size.small
        "Normal" => size.normal
        => size.small
    var table dash = table.new(dash_pos, 2, 45, border_width=1, border_color=color.new(color.gray, 50), bgcolor=color.new(color.black, 85))
    if barstate.islast
        table.clear(dash, 0, 0, 1, 44)
        row = 0
        table.cell(dash, 0, row, "╔═══ ICHIMOKU LAB ═══╗", text_color=color.new(#00E5FF, 0), text_size=text_sz, bgcolor=color.new(#1A237E, 60))
        table.merge_cells(dash, 0, row, 1, row)
        row += 1
        engine_short = str.replace(i_engine, "DAFE ", "⚡")
        table.cell(dash, 0, row, "Engine:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, engine_short, text_color=color.white, text_size=text_sz)
        row += 1
        table.cell(dash, 0, row, "Periods:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, str.tostring(i_tenkan) + "/" + str.tostring(i_kijun) + "/" + str.tostring(i_senkou), text_color=color.yellow, text_size=text_sz)
        row += 1
        table.cell(dash, 0, row, "╔══ CLOUD STATUS ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.teal, 60))
        table.merge_cells(dash, 0, row, 1, row)
        row += 1
        loc_txt = price_above_cloud ? "▲ ABOVE" : price_below_cloud ? "▼ BELOW" : "● INSIDE"
        loc_col = price_above_cloud ? color.green : price_below_cloud ? color.red : color.orange
        table.cell(dash, 0, row, "Price:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, loc_txt, text_color=loc_col, text_size=text_sz)
        row += 1
        tk_txt = tenkan > kijun ? "▲ BULL" : tenkan < kijun ? "▼ BEAR" : "○ FLAT"
        tk_col = tenkan > kijun ? color.green : tenkan < kijun ? color.red : color.gray
        table.cell(dash, 0, row, "TK Cross:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, tk_txt, text_color=tk_col, text_size=text_sz)
        row += 1
        future_txt = future_bull ? "▲ BULLISH" : "▼ BEARISH"
        future_col = future_bull ? color.green : color.red
        table.cell(dash, 0, row, "Future:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, future_txt, text_color=future_col, text_size=text_sz)
        row += 1
        twist_txt = cloud_twist ? "⚠️ TWIST!" : "None"
        twist_col = cloud_twist ? color.orange : color.gray
        table.cell(dash, 0, row, "Twist:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, twist_txt, text_color=twist_col, text_size=text_sz)
        row += 1
        table.cell(dash, 0, row, "╔══ SIGNALS ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.purple, 60))
        table.merge_cells(dash, 0, row, 1, row)
        row += 1
        table.cell(dash, 0, row, "Logic:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, i_signal_mode, text_color=color.aqua, text_size=text_sz)
        row += 1
        mom_col = momentum_score > 65 ? color.green : momentum_score > 35 ? color.yellow : color.red
        table.cell(dash, 0, row, "Momentum:", text_color=color.gray, text_size=text_sz)
        table.cell(dash, 1, row, str.tostring(momentum_score, "#") + "%", text_color=mom_col, text_size=text_sz)
        row += 1
        if i_enable_filters
            table.cell(dash, 0, row, "╔══ FILTERS ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.blue, 60))
            table.merge_cells(dash, 0, row, 1, row)
            row += 1
            all_filters_pass = vol_filter_pass and atr_filter_pass and adx_filter_pass and time_filter_pass
            all_status = all_filters_pass ? "✓ CLEAR" : "✗ BLOCKED"
            all_col = all_filters_pass ? color.green : color.red
            table.cell(dash, 0, row, "Status:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, all_status, text_color=all_col, text_size=text_sz)
            row += 1
        if i_perf_enable
            table.cell(dash, 0, row, "╔══ PERFORMANCE ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.orange, 60))
            table.merge_cells(dash, 0, row, 1, row)
            row += 1
            table.cell(dash, 0, row, "Trades:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(stats.trades) + " (" + str.tostring(stats.wins) + "W/" + str.tostring(stats.losses) + "L)", text_color=color.white, text_size=text_sz)
            row += 1
            win_rate = stats.trades > 0 ? stats.wins / stats.trades * 100 : 0
            wr_col = win_rate > 55 ? color.green : win_rate > 45 ? color.yellow : color.red
            table.cell(dash, 0, row, "Win Rate:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(win_rate, "#.1") + "%", text_color=wr_col, text_size=text_sz)
            row += 1
            pf = stats.loss_pnl > 0 ? stats.win_pnl / stats.loss_pnl : stats.win_pnl > 0 ? 999 : 0
            pf_display = pf > 99 ? ">99" : str.tostring(pf, "#.##")
            pf_col = pf > 1.5 ? color.green : pf > 1.0 ? color.yellow : color.red
            table.cell(dash, 0, row, "Profit Factor:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, pf_display, text_color=pf_col, text_size=text_sz)
            row += 1
            pnl_col = stats.total_pnl > 0 ? color.green : color.red
            pnl_pct = stats.total_pnl / i_capital * 100
            table.cell(dash, 0, row, "Net P&L:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, "$" + str.tostring(stats.total_pnl, "#.##") + " (" + str.tostring(pnl_pct, "#.#") + "%)", text_color=pnl_col, text_size=text_sz)
            row += 1
            dd_col = stats.max_dd > 20 ? color.red : stats.max_dd > 10 ? color.orange : color.green
            table.cell(dash, 0, row, "Max DD:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(stats.max_dd, "#.1") + "%", text_color=dd_col, text_size=text_sz)
            row += 1
            table.cell(dash, 0, row, "╔══ SL/TP (ATR) ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.maroon, 60))
            table.merge_cells(dash, 0, row, 1, row)
            row += 1
            table.cell(dash, 0, row, "Stop Loss:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(i_sl_atr_mult, "#.#") + "× ATR", text_color=color.red, text_size=text_sz)
            row += 1
            table.cell(dash, 0, row, "TP1:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(i_tp1_atr_mult, "#.#") + "× ATR", text_color=color.green, text_size=text_sz)
            row += 1
            table.cell(dash, 0, row, "TP2:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(i_tp2_atr_mult, "#.#") + "× ATR", text_color=color.green, text_size=text_sz)
            row += 1
            table.cell(dash, 0, row, "TP3:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(i_tp3_atr_mult, "#.#") + "× ATR", text_color=color.lime, text_size=text_sz)
            row += 1
            table.cell(dash, 0, row, "╔══ TP HIT RATES ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.green, 60))
            table.merge_cells(dash, 0, row, 1, row)
            row += 1
            tp1_col = tp1_pct > 60 ? color.green : tp1_pct > 40 ? color.yellow : color.red
            table.cell(dash, 0, row, "TP1 Hit:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(stats.tp1_count) + " (" + str.tostring(tp1_pct, "#.1") + "%)", text_color=tp1_col, text_size=text_sz)
            row += 1
            tp2_col = tp2_pct > 50 ? color.green : tp2_pct > 30 ? color.yellow : color.red
            table.cell(dash, 0, row, "TP2 Hit:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(stats.tp2_count) + " (" + str.tostring(tp2_pct, "#.1") + "%)", text_color=tp2_col, text_size=text_sz)
            row += 1
            tp3_col = tp3_pct > 40 ? color.green : tp3_pct > 20 ? color.yellow : color.red
            table.cell(dash, 0, row, "TP3 Hit:", text_color=color.gray, text_size=text_sz)
            table.cell(dash, 1, row, str.tostring(stats.tp3_count) + " (" + str.tostring(tp3_pct, "#.1") + "%)", text_color=tp3_col, text_size=text_sz)
            row += 1
            if stats.in_trade
                table.cell(dash, 0, row, "╔══ POSITION ══╗", text_color=color.white, text_size=text_sz, bgcolor=color.new(color.navy, 60))
                table.merge_cells(dash, 0, row, 1, row)
                row += 1
                pos_txt = stats.direction == 1 ? "🟢 LONG" : "🔴 SHORT"
                unrealized = stats.direction == 1 ? 
                     (close - stats.entry_price) / stats.entry_price * 100 : 
                     (stats.entry_price - close) / stats.entry_price * 100
                unreal_col = unrealized > 0 ? color.green : color.red
                table.cell(dash, 0, row, "Position:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, pos_txt + " " + str.tostring(unrealized, "#.##") + "%", text_color=unreal_col, text_size=text_sz)
                row += 1
                table.cell(dash, 0, row, "Entry:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, str.tostring(stats.entry_price, "#.##"), text_color=color.white, text_size=text_sz)
                row += 1
                table.cell(dash, 0, row, "SL:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, str.tostring(stats.sl_price, "#.##"), text_color=color.red, text_size=text_sz)
                row += 1               
                tp1_status = stats.tp1_hit ? "✓ HIT" : str.tostring(stats.tp1_price, "#.##")
                tp1_stat_col = stats.tp1_hit ? color.lime : color.green
                table.cell(dash, 0, row, "TP1:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, tp1_status, text_color=tp1_stat_col, text_size=text_sz)
                row += 1                
                tp2_status = stats.tp2_hit ? "✓ HIT" : str.tostring(stats.tp2_price, "#.##")
                tp2_stat_col = stats.tp2_hit ? color.lime : color.green
                table.cell(dash, 0, row, "TP2:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, tp2_status, text_color=tp2_stat_col, text_size=text_sz)
                row += 1
                tp3_status = stats.tp3_hit ? "✓ HIT" : str.tostring(stats.tp3_price, "#.##")
                tp3_stat_col = stats.tp3_hit ? color.lime : color.green
                table.cell(dash, 0, row, "TP3:", text_color=color.gray, text_size=text_sz)
                table.cell(dash, 1, row, tp3_status, text_color=tp3_stat_col, text_size=text_sz)
                row += 1
        table.cell(dash, 0, row, "⚡ DAFE Trading ⚡", text_color=color.new(color.purple, 20), text_size=size.tiny)
        table.merge_cells(dash, 0, row, 1, row)
// ═══════════════════════════════════════════════════════════════════════════════
// ALERTS
// ═══════════════════════════════════════════════════════════════════════════════
alertcondition(buy_signal, "Ichimoku Buy", "☁️ Ichimoku Lab: BUY signal on {{ticker}} {{interval}}")
alertcondition(sell_signal, "Ichimoku Sell", "☁️ Ichimoku Lab: SELL signal on {{ticker}} {{interval}}")
alertcondition(tk_cross_bull, "TK Cross Bull", "☁️ Ichimoku Lab: Tenkan crossed above Kijun on {{ticker}}")
