// CALCULATION FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════
type TradeStats
    int trades = 0
    int wins = 0
    int losses = 0
    float total_pnl = 0.0
    float win_pnl = 0.0
    float loss_pnl = 0.0
    float max_dd = 0.0
    float peak_equity = 0.0
    float current_equity = 0.0
    bool in_trade = false
    int direction = 0
    float entry_price = 0.0
    float sl_price = 0.0
    float tp1_price = 0.0
    float tp2_price = 0.0
    float tp3_price = 0.0
    bool tp1_hit = false
    bool tp2_hit = false
    bool tp3_hit = false
    int tp1_count = 0
    int tp2_count = 0
    int tp3_count = 0
    float entry_atr = 0.0
f_donchian(len) => (ta.highest(high, len) + ta.lowest(low, len)) / 2
f_hull(src, len) =>
    half_len = math.max(1, int(len / 2))
    sqrt_len = math.max(1, int(math.sqrt(len)))
    ta.wma(2 * ta.wma(src, half_len) - ta.wma(src, len), sqrt_len)
f_zlema(src, len) =>
    lag = int((len - 1) / 2)
    ta.ema(src + (src - nz(src[lag])), len)
f_kama(src, len) =>
    change = math.abs(src - src[len])
    volatility = math.sum(math.abs(src - src[1]), len)
    er = volatility != 0 ? change / volatility : 0
    fast_sc = 2.0 / 3
    slow_sc = 2.0 / 31
    sc = math.pow(er * (fast_sc - slow_sc) + slow_sc, 2)
    var float kama = na
    kama := na(kama) ? src : kama + sc * (src - kama)
    kama
f_vidya(src, len) =>
    cmo = ta.cmo(src, len)
    alpha = 2 / (len + 1)
    abs_cmo = math.abs(cmo) / 100
    var float vidya = na
    vidya := na(vidya) ? src : alpha * abs_cmo * src + (1 - alpha * abs_cmo) * nz(vidya[1])
    vidya
f_frama(src, len) =>
    half_len = math.max(1, int(len / 2))
    n3 = (ta.highest(high, len) - ta.lowest(low, len)) / len
    n1 = (ta.highest(high, half_len) - ta.lowest(low, half_len)) / half_len
    n2 = (ta.highest(high[half_len], half_len) - ta.lowest(low[half_len], half_len)) / half_len
    dimen = n3 > 0 and n1 + n2 > 0 ? (math.log(n1 + n2) - math.log(n3)) / math.log(2) : 1.5
    alpha = math.exp(-4.6 * (dimen - 1))
    alpha := math.max(0.01, math.min(1, alpha))
    var float frama = na
    frama := na(frama) ? src : alpha * src + (1 - alpha) * nz(frama[1])
    frama
f_mcginley(src, len) =>
    var float md = na
    md := na(md) ? src : md + (src - md) / (len * math.pow(src / md, 4))
    md
f_t3(src, len) =>
    vf = 0.7
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    e4 = ta.ema(e3, len)
    e5 = ta.ema(e4, len)
    e6 = ta.ema(e5, len)
    c1 = -vf * vf * vf
    c2 = 3 * vf * vf + 3 * vf * vf * vf
    c3 = -6 * vf * vf - 3 * vf - 3 * vf * vf * vf
    c4 = 1 + 3 * vf + vf * vf * vf + 3 * vf * vf
    c1 * e6 + c2 * e5 + c3 * e4 + c4 * e3
f_dema(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    2 * e1 - e2
f_tema(src, len) =>
    e1 = ta.ema(src, len)
    e2 = ta.ema(e1, len)
    e3 = ta.ema(e2, len)
    3 * e1 - 3 * e2 + e3
f_zlema_enhanced(src, len) =>
    lag = int((len - 1) / 2)
    data = src + (src - nz(src[lag]))
    f_tema(data, len)
f_supersmoother(src, len) =>
    sqrt2 = math.sqrt(2)
    pi = math.pi
    a1 = math.exp(-sqrt2 * pi / len)
    b1 = 2 * a1 * math.cos(sqrt2 * pi / len)
    c2 = b1
    c3 = -a1 * a1
    c1 = 1 - c2 - c3
    var float ss = na
    ss := na(ss[2]) ? src : c1 * (src + nz(src[1])) / 2 + c2 * nz(ss[1]) + c3 * nz(ss[2])
    ss
f_butterworth(src, len) =>
    sqrt2 = math.sqrt(2)
    pi = math.pi
    a = math.exp(-sqrt2 * pi / len)
    b = 2 * a * math.cos(sqrt2 * pi / len)
    c2 = b
    c3 = -a * a
    c1 = (1 - b + a * a) / 4
    var float bw = na
    bw := na(bw[2]) ? src : c1 * (src + 2 * nz(src[1]) + nz(src[2])) + c2 * nz(bw[1]) + c3 * nz(bw[2])
    bw
f_kalman(src, gain) =>
    var float k_est = na
    var float k_err = 1.0
    q = 0.001
    r = 0.01 * gain
    if na(k_est)
        k_est := src
    k_err := k_err + q
    k_gain = k_err / (k_err + r)
    k_est := k_est + k_gain * (src - k_est)
    k_err := (1 - k_gain) * k_err
    k_est
f_gaussian(src, len) =>
    pi = math.pi
    beta = 2.415 * (1 - math.cos(2 * pi / len)) / (1 + math.cos(2 * pi / len))
    alpha = -beta + math.sqrt(beta * beta + 2 * beta)
    var float g = na
    g := na(g) ? src : alpha * src + (1 - alpha) * nz(g[1])
    g
f_laguerre(src, gamma) =>
    var float L0 = na, var float L1 = na, var float L2 = na, var float L3 = na
    L0 := (1 - gamma) * src + gamma * nz(L0[1])
    L1 := -gamma * L0 + nz(L0[1]) + gamma * nz(L1[1])
    L2 := -gamma * L1 + nz(L1[1]) + gamma * nz(L2[1])
    L3 := -gamma * L2 + nz(L2[1]) + gamma * nz(L3[1])
    (L0 + 2 * L1 + 2 * L2 + L3) / 6
f_adaptive_laguerre(src, len) =>
    vol_ratio = ta.atr(14) / ta.sma(ta.atr(14), 50)
    gamma = math.min(0.9, math.max(0.1, 0.5 / vol_ratio))
    f_laguerre(src, gamma)
f_savitzky_golay(src, len) =>
    sum_val = 0.0
    sum_w = 0.0
    for i = 0 to len - 1
        w = (len - i) * (len - i)
        sum_val += nz(src[i]) * w
        sum_w += w
    sum_w > 0 ? sum_val / sum_w : src
f_hamming(src, len) =>
    sum_w = 0.0
    sum_val = 0.0
    for i = 0 to len - 1
        w = 0.54 - 0.46 * math.cos(2 * math.pi * i / (len - 1))
        sum_w += w
        sum_val += w * nz(src[i])
    sum_w > 0 ? sum_val / sum_w : src
f_hann(src, len) =>
    sum_w = 0.0
    sum_val = 0.0
    for i = 0 to len - 1
        w = 0.5 * (1 - math.cos(2 * math.pi * i / (len - 1)))
        sum_w += w
        sum_val += w * nz(src[i])
    sum_w > 0 ? sum_val / sum_w : src
f_blackman(src, len) =>
    sum_w = 0.0
    sum_val = 0.0
    for i = 0 to len - 1
        w = 0.42 - 0.5 * math.cos(2 * math.pi * i / (len - 1)) + 0.08 * math.cos(4 * math.pi * i / (len - 1))
        sum_w += w
        sum_val += w * nz(src[i])
    sum_w > 0 ? sum_val / sum_w : src
f_lsma(src, len) => ta.linreg(src, len, 0)
f_poly_reg(src, len) =>
    lsma = ta.linreg(src, len, 0)
    slope = (lsma - lsma[1])
    lsma + slope * len / 4
f_median(src, len) => ta.median(src, len)
f_trimmed_mean(src, len) =>
    p90 = ta.percentile_linear_interpolation(src, len, 90)
    p10 = ta.percentile_linear_interpolation(src, len, 10)
    ta.sma(math.min(p90, math.max(p10, src)), len)
f_geometric_mean(src, len) =>
    product = 1.0
    for i = 0 to len - 1
        product *= math.max(nz(src[i]), 0.0001)
    math.pow(product, 1.0 / len)
f_harmonic_mean(src, len) =>
    sum_inv = 0.0
    for i = 0 to len - 1
        sum_inv += 1.0 / math.max(nz(src[i]), 0.0001)
    len / sum_inv
f_quadratic(src, len) =>
    sum_val = 0.0
    sum_w = 0.0
    for i = 0 to len - 1
        w = math.pow(len - i, 2)
        sum_val += nz(src[i]) * w
        sum_w += w
    sum_w > 0 ? sum_val / sum_w : src
f_cubic(src, len) =>
    sum_val = 0.0
    sum_w = 0.0
    for i = 0 to len - 1
        w = math.pow(len - i, 3)
        sum_val += nz(src[i]) * w
        sum_w += w
    sum_w > 0 ? sum_val / sum_w : src
f_vwap(len) =>
    sum_pv = 0.0
    sum_v = 0.0
    for i = 0 to len - 1
        sum_pv += nz(close[i] * volume[i])
        sum_v += nz(volume[i])
    sum_v > 0 ? sum_pv / sum_v : close
f_money_flow(src, len) =>
    typical = (high + low + close) / 3
    mf = typical * volume
    sum_mf = math.sum(mf, len)
    sum_v = math.sum(volume, len)
    sum_v > 0 ? sum_mf / sum_v : src
f_tick_volume(src, len) =>
    tv = volume
    sum_val = 0.0
    sum_vol = 0.0
    for i = 0 to len - 1
        sum_val += nz(src[i]) * nz(tv[i])
        sum_vol += nz(tv[i])
    sum_vol > 0 ? sum_val / sum_vol : src
f_accumulation_dist(src, len) =>
    ad = ((close - low) - (high - close)) / (high - low) * volume
    cum_ad = ta.cum(ad)
    ta.sma(cum_ad, len)
f_atr_adaptive(src, len) =>
    atr = ta.atr(len)
    atr_avg = ta.sma(atr, len)
    ratio = atr_avg > 0 ? atr / atr_avg : 1.0
    base_alpha = 2.0 / (len + 1)
    adaptive_alpha = math.min(0.5, math.max(0.01, base_alpha * ratio))
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_volatility_modulated(src, len) =>
    std = ta.stdev(src, len)
    avg_std = ta.sma(std, len)
    ratio = avg_std > 0 ? std / avg_std : 1.0
    base_alpha = 2.0 / (len + 1)
    adaptive_alpha = math.min(0.5, math.max(0.01, base_alpha / ratio))
    var float vm = na
    vm := na(vm) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(vm[1])
    vm
f_efficiency_ratio(src, len) =>
    change = math.abs(src - src[len])
    volatility = math.sum(math.abs(src - src[1]), len)
    er = volatility != 0 ? change / volatility : 0.0
    fast_alpha = 2.0 / 3.0
    slow_alpha = 2.0 / 31.0
    adaptive_alpha = math.pow(er * (fast_alpha - slow_alpha) + slow_alpha, 2)
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_entropy_adaptive(src, len) =>
    sum_changes = 0.0
    for i = 1 to len
        sum_changes += math.abs(src[i] - src[i - 1])
    entropy = sum_changes / len
    avg_entropy = ta.sma(entropy, len)
    ratio = avg_entropy > 0 ? entropy / avg_entropy : 1.0
    base_alpha = 2.0 / (len + 1)
    adaptive_alpha = math.min(0.5, math.max(0.01, base_alpha / ratio))
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_fractal_adaptive(src, len) =>
    n = len
    n1 = (ta.highest(high, n) - ta.lowest(low, n)) / n
    half = int(n / 2)
    n2 = (ta.highest(high, half) - ta.lowest(low, half)) / half
    n3 = (ta.highest(high[half], half) - ta.lowest(low[half], half)) / half
    dimen = n1 > 0 and n2 + n3 > 0 ? (math.log(n2 + n3) - math.log(n1)) / math.log(2) : 1.5
    alpha = math.exp(-4.6 * (dimen - 1))
    alpha := math.max(0.01, math.min(0.99, alpha))
    var float fd = na
    fd := na(fd) ? src : alpha * src + (1 - alpha) * nz(fd[1])
    fd
f_cycle_period(src, len) => ta.ema(src, len)
f_rsi_modulated(src, len) =>
    rsi = ta.rsi(close, 14)
    base_alpha = 2.0 / (len + 1)
    mod = rsi > 70 or rsi < 30 ? 2.0 : 1.0
    adaptive_alpha = math.min(0.5, base_alpha * mod)
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_macd_modulated(src, len) =>
    [macd_line, signal_line, _] = ta.macd(close, 12, 26, 9)
    diff = math.abs(macd_line - signal_line)
    base_alpha = 2.0 / (len + 1)
    mod = diff > 1 ? 1.5 : 1.0
    adaptive_alpha = math.min(0.5, base_alpha * mod)
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_stoch_modulated(src, len) =>
    k = ta.stoch(close, high, low, 14)
    base_alpha = 2.0 / (len + 1)
    mod = k > 80 or k < 20 ? 1.8 : 1.0
    adaptive_alpha = math.min(0.5, base_alpha * mod)
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_adx_modulated(src, len) =>
    [_, _, adx] = ta.dmi(14, 14)
    base_alpha = 2.0 / (len + 1)
    mod = adx < 25 ? 0.5 : adx > 40 ? 1.5 : 1.0
    adaptive_alpha = math.min(0.5, math.max(0.01, base_alpha * mod))
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_dafe_flux(src, len) =>
    bb_width = ta.stdev(src, len)
    bb_avg = ta.sma(bb_width, len)
    flux_ratio = bb_avg > 0 ? bb_width / bb_avg : 1
    sigmoid = 1 / (1 + math.exp(-flux_ratio + 1))
    alpha = 2 / (len + 1) * (1 + sigmoid)
    alpha := math.min(0.99, alpha)
    var float flux = na
    flux := na(flux) ? src : alpha * src + (1 - alpha) * nz(flux[1])
    flux
f_dafe_tensor(len) =>
    tensor_src = (open + 2 * high + 2 * low + 3 * close) / 8
    f_hull(tensor_src, len)
f_dafe_quantum(src, len) =>
    step_size = ta.atr(len) * 0.5
    var float quantum = na
    quantum := na(quantum) ? src : math.abs(src - quantum) > step_size ? src : quantum
    ta.ema(quantum, math.max(2, int(len / 4)))
f_dafe_spectral(src, len) =>
    lp = ta.ema(src, len)
    hp = src - lp
    lp + hp * 0.1
f_dafe_gravity(src, len) =>
    sum_weighted = 0.0
    sum_weights = 0.0
    for i = 0 to len - 1
        weight = (len - i) * (nz(volume[i]) + 1)
        sum_weighted += nz(src[i]) * weight
        sum_weights += weight
    sum_weights > 0 ? sum_weighted / sum_weights : src
f_dafe_phase_zero(src, len) =>
    ema1 = ta.ema(src, len)
    ema2 = ta.ema(ema1, len)
    ema1 + (ema1 - ema2)
f_dafe_entropy(src, len) =>
    sum_changes = 0.0
    for i = 1 to len
        sum_changes += math.abs(src[i] - src[i - 1])
    entropy = sum_changes / len
    avg_entropy = ta.sma(entropy, len)
    ratio = avg_entropy > 0 ? entropy / avg_entropy : 1.0
    base_alpha = 2.0 / (len + 1)
    adaptive_alpha = math.min(0.5, math.max(0.01, base_alpha / ratio))
    var float result = na
    result := na(result) ? src : adaptive_alpha * src + (1 - adaptive_alpha) * nz(result[1])
    result
f_dafe_fractal(src, len) => f_fractal_adaptive(src, len)
f_dafe_neural(src, len) =>
    var float jma = 0.0
    var float e0 = 0.0, var float e1 = 0.0
    beta = 0.45
    alpha = math.pow(len, beta)
    e0 := (1 - 1/alpha) * src + (1/alpha) * nz(e0[1])
    e1 := (src - e0) * (1 - 1/alpha) + (1/alpha) * nz(e1[1])
    jma := e0
    jma
f_dafe_hybrid_neuro(src, len) =>
    hull = f_hull(src, len)
    f_kalman(hull, 1.0)
f_dafe_kalman_predictive(src, len) =>
    k1 = f_kalman(src, 1.0)
    f_kalman(k1, 0.5)
f_dafe_consensus(src, len) =>
    m1 = f_donchian(len)
    m2 = f_hull(src, len)
    m3 = f_kama(src, len)
    m4 = ta.ema(src, len)
    m5 = f_lsma(src, len)
    (m1 + m2 + m3 + m4 + m5) / 5
f_dafe_ultimate(src, len) =>
    w1 = f_dafe_flux(src, len)
    w2 = f_dafe_tensor(len)
    w3 = f_dafe_spectral(src, len)
    w4 = f_dafe_gravity(src, len)
    w5 = f_dafe_phase_zero(src, len)
    (w1 * 0.25 + w2 * 0.25 + w3 * 0.2 + w4 * 0.15 + w5 * 0.15)
